# =============================================================================
# E-CiudAgad - PRODUCTION environment variables (Render.com free deployment)
# -----------------------------------------------------------------------------
# Do NOT copy this file into the repo's .env. Instead, paste the values into
# Render Dashboard -> your Web Service -> Environment -> Add Environment Variable
# =============================================================================

APP_NAME="E-CiudAgad"
APP_ENV=production
APP_KEY=
#   Generate locally:  php artisan key:generate --show   -> paste the result
APP_DEBUG=false
APP_URL=https://YOUR-APP-NAME.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# DATABASE - TiDB Cloud Serverless (free forever, MySQL-compatible, TLS required)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=xxxxxxxx.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=e_ciudadagad
DB_USERNAME=xxxxxxxx.root
DB_PASSWORD=your-password

# Option A (recommended) - full TLS verification:
#   download ca.pem from the TiDB Cloud console and make it available inside
#   the container image (e.g. commit it to the repo or COPY it in the Dockerfile).
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/tidb-ca.pem

# Option B (no cert file needed) - TLS encrypted, no server-cert verification.
#   Use only one of the two options. Laravel reads both from config/database.php.
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# -----------------------------------------------------------------------------
# SESSION / CACHE / QUEUE
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

# -----------------------------------------------------------------------------
# FILE STORAGE - Cloudflare R2 (free forever, 10 GB, S3-compatible)
# Files (ID pictures, request documents, generated document SVG/PDFs) persist
# across redeploys ONLY when stored on R2. Without these vars the private disk
# stays local and files are erased on every redeploy.
# -----------------------------------------------------------------------------
PRIVATE_DISK_DRIVER=s3
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=e-ciudadagad-files
R2_REGION=auto
R2_ENDPOINT=https://ACCOUNT-ID.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# MAIL - Brevo SMTP (free, 300 emails/day) for PIN reset / password reset
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-login
MAIL_PASSWORD=your-smtp-master-key
MAIL_FROM_ADDRESS=no-reply@eciudadagad.gov.ph
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# DEMO DATA - seed sample residents/requests on fresh databases.
# Default: skipped in production. Set to "true" only for acceptance testing.
# -----------------------------------------------------------------------------
SEED_DEMO_DATA=false